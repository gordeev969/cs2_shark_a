# Copy to .env on your VPS. Point this hostname's A/AAAA records at the VPS.
ANALYZER_DOMAIN=cs2.example.com
CS2_REQUIRE_STEAM_LOGIN=true
CS2_MAX_UPLOAD_MB=512
CS2_PARSER_TIMEOUT=180
CS2_RETAIN_DEMOS=false

# Optional for login; required for match discovery and public profile details.
STEAM_WEB_API_KEY=

# Empty: generate and retain the encryption key inside the analyzer-data volume.
CS2_SECRET_KEY=

# Optional automatic demo downloads. Set URL after configuring the gc profile.
CS2_GC_URL=
CS2_GC_SECRET=
