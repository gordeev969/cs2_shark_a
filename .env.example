CS2_DATA_DIR=./data
CS2_MAX_UPLOAD_MB=512
# Global limit: queued + actively parsed demos, across all users
CS2_MAX_PENDING_IMPORTS=8
CS2_PARSER_TIMEOUT=180
CS2_RETAIN_DEMOS=false
CS2_REQUIRE_STEAM_LOGIN=true
# Browser address: Compose 8000; native Vite use http://127.0.0.1:5173
STEAM_PUBLIC_URL=http://127.0.0.1:8000
# Server-side key from https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# Leave empty to generate a local encryption key in CS2_DATA_DIR
CS2_SECRET_KEY=
# Optional GC worker; for Compose profile gc use http://gc-worker:8001
CS2_GC_URL=
# Generate a random value, >=24 chars, same for backend and GC worker
CS2_GC_SECRET=
